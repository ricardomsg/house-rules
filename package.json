{
  "name": "house-rules",
  "version": "0.2.3",
  "private": true,
  "engines": {
    "node": ">=22.16.0"
  },
  "scripts": {
    "dev": "next dev --hostname 0.0.0.0",
    "build": "node scripts/build.mjs",
    "start": "next start --hostname 0.0.0.0",
    "lint": "eslint . --ignore-pattern dist --ignore-pattern .next",
    "db:generate": "drizzle-kit generate",
    "test:multiplayer": "node scripts/multiplayer-matrix.mjs",
    "test:boundaries": "node scripts/player-boundaries-test.mjs",
    "test:i18n": "node --experimental-strip-types scripts/i18n-test.mjs",
    "test:games": "npm run test:database && npm run test:client && npm run test:continuity && npm run test:advocate && npm run test:recovery && npm run test:feedback && npm run test:charades-turns && npm run test:i18n && npm run test:boundaries && npm run test:multiplayer && npm run test:admin && npm run test:standings",
    "test:admin": "node scripts/room-admin-test.mjs",
    "test:standings": "node scripts/room-standings-test.mjs",
    "db:backup": "node --env-file-if-exists=.env.local scripts/backup-db.mjs",
    "test:database": "node --experimental-strip-types scripts/local-db-test.mjs",
    "addresses": "node scripts/local-addresses.mjs",
    "prestart": "npm run addresses",
    "predev": "npm run addresses",
    "test:advocate": "node scripts/devils-advocate-test.mjs",
    "test:recovery": "node scripts/game-recovery-test.mjs",
    "test:client": "node scripts/refresh-order-test.mjs && node scripts/browser-storage-test.mjs",
    "test:charades-browser": "node scripts/charades-browser-test.mjs",
    "test:charades-turns": "node scripts/charades-turns-test.mjs",
    "test:continuity": "node scripts/seat-continuity-test.mjs",
    "build:cloudflare": "CLOUDFLARE_BUILD=1 npm run build",
    "dev:cloudflare": "vinext dev --port 3102",
    "db:migrate:local": "wrangler d1 migrations apply DB --local --config wrangler.jsonc --persist-to .wrangler/cloudflare-state",
    "db:migrate:remote": "node scripts/cloudflare-production.mjs migrate",
    "build:cloudflare:production": "node scripts/cloudflare-production.mjs build",
    "deploy:cloudflare": "node scripts/cloudflare-production.mjs deploy",
    "test:table-flow": "node scripts/table-flow-test.mjs",
    "test:feedback": "node scripts/table-flow-test.mjs && node scripts/identity-game-test.mjs && node scripts/human-scale-flow-test.mjs && node scripts/human-scale-game-test.mjs && node scripts/charades-teams-test.mjs && node scripts/room-card-history-test.mjs && npm run test:catalog",
    "test:catalog": "node scripts/card-catalog-test.mjs"
  },
  "dependencies": {
    "drizzle-orm": "0.45.2",
    "next": "16.3.8",
    "react": "19.3.0",
    "react-dom": "19.3.0"
  },
  "devDependencies": {
    "@cloudflare/vite-plugin": "1.62.5",
    "@cloudflare/workers-types": "5.20261004.1",
    "@tailwindcss/postcss": "4.2.1",
    "@types/node": "22.19.19",
    "@types/react": "19.2.14",
    "@types/react-dom": "19.2.3",
    "@vitejs/plugin-react": "6.1.1",
    "@vitejs/plugin-rsc": "0.5.35",
    "drizzle-kit": "0.31.10",
    "eslint": "9.39.4",
    "eslint-config-next": "16.3.8",
    "playwright": "1.63.0",
    "react-server-dom-webpack": "19.3.0",
    "tailwindcss": "4.2.1",
    "typescript": "5.9.3",
    "vinext": "1.0.1",
    "vite": "8.3.2",
    "wrangler": "4.147.0"
  },
  "type": "module"
}
